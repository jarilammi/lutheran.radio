# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore
#
# Comments must occupy their own line. A trailing "# ..." on a pattern line is
# part of the pattern — gitignore has no end-of-line comments.

## User settings
xcuserdata/

## Obj-C/Swift specific
*.hmap

## App packaging
*.ipa
*.dSYM.zip
*.dSYM

## Playgrounds
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
#
# Add this line if you want to avoid checking in source code from Swift Package Manager dependencies.
# Packages/
# Package.pins
# Package.resolved
# *.xcodeproj
#
# Xcode automatically generates this directory with a .xcworkspacedata file and xcuserdata
# hence it is not needed unless you have added a package configuration file to your project
# .swiftpm

.build/

# CocoaPods
#
# We recommend against adding the Pods directory to your .gitignore. However
# you should judge for yourself, the pros and cons are mentioned at:
# https://guides.cocoapods.org/using/using-cocoapods.html#should-i-check-the-pods-directory-into-source-control
#
# Pods/
#
# Add this line if you want to avoid checking in source code from the Xcode workspace
# *.xcworkspace

# Carthage
#
# Add this line if you want to avoid checking in source code from Carthage dependencies.
# Carthage/Checkouts

Carthage/Build/

# fastlane
#
# It is recommended to not store the screenshots in the git repo.
# Instead, use fastlane to re-generate the screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/#source-control

fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Secrets and credentials
# Apple Push Notification service keys
*.p8
# iOS Distribution certificates
*.p12
# iOS certificates
*.cer
# iOS provisioning profiles
*.mobileprovision
# Keychain files
*.keychain
# Environment files that might contain API keys/secrets
.env*
# Firebase configuration
**/GoogleService-Info.plist
# Custom keys/config files
**/Keys.plist
**/Secrets.plist
# Files containing API keys
ApiKeys.swift
Secrets.swift
# Xcode configuration files that might contain secrets
Config.xcconfig

# Additional build artifacts
# Generated files that might contain secrets
*.generated.swift
build/
# More comprehensive than just xcuserdata
DerivedData/

# IDE / editor / OS junk
# AppCode
.idea/
# If storing sensitive data in xcconfig files
*.xcconfig
# macOS Finder folder metadata
.DS_Store
# Vim temporary files
*.swp
# Interface builder temporary files
*~.nib

# Agent tooling alias — canonical source is CODING_AGENT.md
/AGENTS.md

# Unpublished local working notes
docs/local/

# Generated tuning sound files
Lutheran Radio/Tools/*.wav

# LaTeX compilation files
*.aux
*.fdb_latexmk
*.fls
*.log
