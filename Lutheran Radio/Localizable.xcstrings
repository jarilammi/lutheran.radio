    "open_app_first" : {
      "comment" : "Home-widget passive chrome secondary caption (medium/large) when the main app process is not recently active. Used from WidgetSurface `WidgetPassiveTapToOpenChrome` via String(localized:table: Localizable). extractionState is manual because the catalog is owned by the main app/widget targets; the call site lives in WidgetSurface and is not seen by Xcode auto-extraction.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "መጀመሪያ መተግበሪያውን ይክፈቱ"
