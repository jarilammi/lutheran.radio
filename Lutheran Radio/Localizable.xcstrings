    "security_model_error_message" : {
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በደህንነት ማረጋገጫ ውድቀት ምክንያት መጫወት መጀመር አልተቻለም። እባክዎ የበይነመረብ ግንኙነትዎን ይፈትሹ እና መተግበሪያው ወቅታዊ መሆኑን ያረጋግጡ። ችግሩ ከቀጠለ መተግበሪያውን እንደገና ያስጀምሩና እንደገና ይሞክሩ።"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не може да се стартира възпроизвеждане поради неуспешна проверка на сигурността. Моля, проверете интернет връзката си и се уверете, че приложението е актуално. Ако проблемът продължава, рестартирайте приложението и опитайте отново."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přehrávání nelze spustit kvůli selhání ověření zabezpečení. Zkontrolujte internetové připojení a ujistěte se, že je aplikace aktuální. Pokud problém přetrvává, restartujte aplikaci a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan ikke starte afspilning på grund af en fejl i sikkerhedsvalideringen. Kontroller venligst din internetforbindelse og sørg for, at appen er opdateret. Hvis problemet fortsætter, genstart appen og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wiedergabe kann aufgrund eines Fehlers bei der Sicherheitsüberprüfung nicht gestartet werden. Bitte überprüfen Sie Ihre Internetverbindung und stellen Sie sicher, dass die App aktuell ist. Wenn das Problem weiterhin besteht, starten Sie die App neu und versuchen Sie es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν είναι δυνατή η έναρξη της αναπαραγωγής λόγω αποτυχίας επαλήθευσης ασφαλείας. Ελέγξτε τη σύνδεσή σας στο διαδίκτυο και βεβαιωθείτε ότι η εφαρμογή είναι ενημερωμένη. Αν το πρόβλημα συνεχίζεται, επανεκκινήστε την εφαρμογή και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unable to start playback due to a security validation failure. Please check your internet connection and make sure the app is up to date. If the issue continues, restart the app and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede iniciar la reproducción debido a un fallo en la validación de seguridad. Comprueba tu conexión a internet y asegúrate de que la app esté actualizada. Si el problema persiste, reinicia la app e inténtalo de nuevo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei saa taasesitust alustada turvavalideerimise tõrke tõttu. Palun kontrollige oma internetiühendust ja veenduge, et rakendus on ajakohane. Kui probleem püsib, taaskäivitage rakendus ja proovige uuesti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toistoa ei voida käynnistää turvallisuusvarmennuksen epäonnistumisen vuoksi. Tarkista internet-yhteytesi ja varmista, että sovellus on ajan tasalla. Jos ongelma jatkuu, käynnistä sovellus uudelleen ja yritä uudestaan."
          }
        },
        "fit" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei saata alottaa soittamista kun turvavalidointi meni pieleen. Tarkista internet-yhteys ja katto, että sovellus on ajantasalla. Jos vika vielä jatkuu, käynnistä sovellus uuvestaan ja koeta toisen kerran."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kann ikki byrja avspæling vegna ein feil í trygdarvalideringini. Vinarliga kanna títt internet sambandið og tryggja, at appin er dagførd. Um trupulleikin heldur fram, byrja appina umaftur og royn aftur."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de démarrer la lecture en raison d’un échec de validation de sécurité. Vérifiez votre connexion Internet et assurez-vous que l’app est à jour. Si le problème persiste, redémarrez l’app et réessayez."
          }
        },
        "gag" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eminlik kontrolu yannışından çalmaa başlanameer. Internet bağlantını kontrol et hem aplikatsiyanın eni versiyada olduuunu bak. Problem devam ederä, aplikatsiyanı kapat hem taa bir kerä aç, sora gene dene."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprodukciju nije moguće pokrenuti zbog neuspjele sigurnosne provjere. Provjerite internetsku vezu i uvjerite se da je aplikacija ažurirana. Ako se problem nastavi, ponovno pokrenite aplikaciju i pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lejátszás nem indítható biztonsági ellenőrzési hiba miatt. Ellenőrizze az internetkapcsolatot, és győződjön meg arról, hogy az app naprakész. Ha a probléma továbbra is fennáll, indítsa újra az appot, és próbálja meg újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat memulai pemutaran karena validasi keamanan gagal. Periksa koneksi internet Anda dan pastikan app sudah versi terbaru. Jika masalah berlanjut, mulai ulang app dan coba lagi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekki er hægt að hefja spilun vegna bilunar í öryggisstaðfestingu. Vinsamlegast athugaðu internettenginguna þína og gakktu úr skugga um að appið sé uppfært. Ef vandamálið heldur áfram, endurræstu appið og reyndu aftur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile avviare la riproduzione a causa di un errore di convalida della sicurezza. Controlla la connessione Internet e assicurati che l’app sia aggiornata. Se il problema persiste, riavvia l’app e riprova."
          }
        },
        "kl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nipilersorneq atorlugu siumut qanoq iliuuseq ajorpoq. Internettit atungaata toqqammavigit aammalu appi nutartertariaqarnera iliuusigit. Naak ajornartorpoq, appi nutaaq alerfigit naammit naammagunarpat."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyksta pradėti atkūrimo dėl saugumo patvirtinimo klaidos. Prašome patikrinti interneto ryšį ir įsitikinti, kad programa atnaujinta. Jei problema išlieka, paleiskite programą iš naujo ir bandykite dar kartą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nevar sākt atskaņošanu drošības validācijas kļūmes dēļ. Lūdzu, pārbaudiet interneta savienojumu un pārliecinieties, ka lietotne ir atjaunināta. Ja problēma turpinās, restartējiet lietotni un mēģiniet vēlreiz."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan ikke starte avspilling på grunn av en feil i sikkerhetsvalideringen. Vennligst sjekk internettforbindelsen din og forsikre deg om at appen er oppdatert. Hvis problemet vedvarer, start appen på nytt og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de afspeling niet starten vanwege een beveiligingsvalidatiefout. Controleer je internetverbinding en zorg dat de app up-to-date is. Als het probleem aanhoudt, herstart de app en probeer het opnieuw."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan ikkje starte avspeling på grunn av ein feil i tryggleiksvalideringa. Ver snill og sjekk internettforbindelsen din og sjå til at appen er oppdatert. Dersom problemet held fram, start appen på nytt og prøv igjen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można rozpocząć odtwarzania z powodu niepowodzenia weryfikacji bezpieczeństwa. Proszę sprawdzić połączenie internetowe i upewnić się, że aplikacja jest zaktualizowana. Jeśli problem nadal występuje, uruchom ponownie aplikację i spróbuj jeszcze raz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível iniciar a reprodução devido a uma falha na validação de segurança. Verifique a sua ligação à Internet e certifique-se de que a app está atualizada. Se o problema continuar, reinicie a app e tente novamente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível iniciar a reprodução devido a uma falha na validação de segurança. Verifique sua conexão com a Internet e certifique-se de que o app está atualizado. Se o problema continuar, reinicie o app e tente de novo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redarea nu poate fi pornită din cauza unei erori de validare a securității. Verifică conexiunea la internet și asigură-te că aplicația este actualizată. Dacă problema persistă, repornește aplicația și încearcă din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удается начать воспроизведение из-за сбоя проверки безопасности. Пожалуйста, проверьте подключение к интернету и убедитесь, что приложение обновлено. Если проблема сохраняется, перезапустите приложение и попробуйте снова."
          }
        },
        "se" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ii sáhte álggit čuojahan go sihkarvuohtačielggadeapmi ii lihkos. Dárkkis interneahttačatnosa ja áddeštá ahte applikašuvdna lea ođđasit. Jos váttisvuohta joatka, álggat applikašuvnna ođđasit ja geahča ođđasit."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prehrávanie sa nepodarilo spustiť kvôli zlyhaniu bezpečnostnej validácie. Skontrolujte internetové pripojenie a uistite sa, že máte najnovšiu verziu aplikácie. Ak problém pretrváva, reštartujte aplikáciu a skúste to znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predvajanja ni mogoče začeti zaradi neuspešnega varnostnega preverjanja. Preverite internetno povezavo in se prepričajte, da je aplikacija posodobljena. Če težava ostane, znova zaženite aplikacijo in poskusite znova."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuk mund të niset luajtja për shkak të dështimit të validimit të sigurisë. Kontrolloni lidhjen me internetin dhe sigurohuni që aplikacioni është i përditësuar. Nëse problemi vazhdon, rinisni aplikacionin dhe provoni përsëri."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan inte starta uppspelning på grund av ett fel i säkerhetsvalideringen. Vänligen kontrollera din internetanslutning och se till att appen är uppdaterad. Om problemet kvarstår, starta om appen och försök igen."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imeshindwa kuanza uchezaji kwa sababu ya kushindwa kwa uthibitishaji wa usalama. Tafadhali angalia muunganisho wako wa intaneti na uhakikishe programu imesasishwa. Ikiwa tatizo litaendelea, anzisha tena programu na ujaribu tena."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "భద్రతా ధృవీకరణ వైఫల్యం కారణంగా ప్లేబ్యాక్ ప్రారంభించలేకపోయాం. దయచేసి మీ ఇంటర్నెట్ కనెక్షన్‌ని తనిఖీ చేసి, యాప్ తాజాగా ఉందని నిర్ధారించుకోండి. సమస్య కొనసాగితే, యాప్‌ని పునఃప్రారంభించి మళ్లీ ప్రయత్నించండి."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдається почати відтворення через збій перевірки безпеки. Будь ласка, перевірте підключення до інтернету та переконайтеся, що програму оновлено. Якщо проблема не зникає, перезапустіть програму й спробуйте знову."
          }
        }
      }
    },
