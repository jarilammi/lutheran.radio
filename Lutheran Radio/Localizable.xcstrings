    "mobile_data_usage_message" : {
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "መተግበሪያው የሞባይል ውሂብ እየተጠቀመ ነው፣ ይህም በውሂብ እቅድዎ መሠረት ክፍያ ሊያስከትል ይችላል።"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложението използва мобилни данни, което може да доведе до допълнителни разходи в зависимост от вашия тарифен план."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace používá mobilní data, což může podle vašeho tarifu znamenat dodatečné náklady."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen bruger mobildata, hvilket kan medføre omkostninger afhængigt af din dataplan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App verwendet mobile Daten, was je nach Ihrem Datentarif Kosten verursachen kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εφαρμογή χρησιμοποιεί δεδομένα κινητής, κάτι που ενδέχεται να επιφέρει χρεώσεις ανάλογα με το πρόγραμμα δεδομένων σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app is using mobile data, which may incur costs depending on your data plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app está usando datos móviles, lo que puede generar costos según tu plan de datos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rakendus kasutab mobiilset andmesidet, mis võib sõltuvalt teie andmesideplaanist kaasa tuua kulusid."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovellus käyttää mobiilidataa, mikä voi aiheuttaa kustannuksia riippuen datapaketistasi."
          }
        },
        "fit" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovellus käyttää mobiilidataa, mikä saattaa aiheuttaa kuluja riippuen datapaketistasi."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appurin brúkar fartelefon data, sum kann kosta pening avmarka av tínum dataætlan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app utilise les données mobiles, ce qui peut engendrer des frais selon votre forfait."
          }
        },
        "gag" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikatsiya mobil data kullanêr; bu, senin data tarifäna görä masrafa sebep olabilir."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija koristi mobilne podatke, što može uzrokovati dodatne troškove ovisno o vašoj tarifi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az app mobiladatot használ, ami a díjcsomagjától függően költségekkel járhat."
          }
        },
        "id" : {
          "stringUnit" : {
