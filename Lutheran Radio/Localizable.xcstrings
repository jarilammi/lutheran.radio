    "ssl_transition_message" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поточните сървъри са обновили SSL сертификатите си. Приложението работи в режим на съвместимост. Моля, актуализирайте до най-новата версия, когато е налична, за оптимална сигурност."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streamovací servery obnovily své SSL certifikáty. Aplikace pracuje v režimu kompatibility. Aktualizujte na nejnovější verzi, až bude k dispozici, pro optimální zabezpečení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaming-serverne har fornyet deres SSL-certifikater. Appen kører i kompatibilitetstilstand. Opdater venligst til den nyeste version, når den er tilgængelig, for optimal sikkerhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Streaming-Server haben ihre SSL-Zertifikate erneuert. Die App läuft im Kompatibilitätsmodus. Bitte aktualisieren Sie auf die neueste Version, wenn verfügbar, für optimale Sicherheit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι διακομιστές ροής έχουν ανανεώσει τα πιστοποιητικά SSL τους. Η εφαρμογή λειτουργεί σε λειτουργία συμβατότητας. Ενημερώστε στην πιο πρόσφατη έκδοση όταν είναι διαθέσιμη για βέλτιστη ασφάλεια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The streaming servers have renewed their SSL certificates. The app is working in compatibility mode. Please update to the latest version when available for optimal security."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los servidores de streaming han renovado sus certificados SSL. La app funciona en modo de compatibilidad. Actualiza a la versión más reciente cuando esté disponible para una seguridad óptima."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voogesitusserverid on uuendanud oma SSL-sertifikaate. Rakendus töötab ühilduvusrežiimis. Palun värskendage uusimale versioonile, kui see on saadaval optimaalse turvalisuse tagamiseks."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suoratoistopalvelimet ovat uusineet SSL-sertifikaattinsa. Sovellus toimii yhteensopivuustilassa. Päivitä uusimpaan versioon kun saatavilla optimaalisen turvallisuuden takaamiseksi."
          }
        },
        "fit" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suoratoisto-palvelimet ovat uusinheet SSL-varmentensa. Sovellus toimii yhteensopivuus-tilassa. Päivitä uusimphan versioonhin ko se on saatavilla parhaan turvallisuuen takia."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaming-tænarar hava endurnýtt síni SSL-váttanarbræv. Appið virkar í sambæriligheitsstøðu. Vinarliga dagfør til nýggjastu útgávuna, tá hon er tøk, fyri besta trygd."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les serveurs de diffusion ont renouvelé leurs certificats SSL. L’app fonctionne en mode de compatibilité. Mettez à jour vers la dernière version dès qu’elle sera disponible pour une sécurité optimale."
          }
        },
        "gag" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yayın serverleri SSL sertifikatlarını eniledi. Aplikatsiya uyum modunda işleer. En iyi eminlik üçin, eni versiya çıkınca aplikatsiyanı enile."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslužitelji za streaming obnovili su svoje SSL certifikate. Aplikacija radi u načinu kompatibilnosti. Ažurirajte na najnoviju verziju kada bude dostupna radi optimalne sigurnosti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A streamingszerverek megújították az SSL-tanúsítványaikat. Az app kompatibilitási módban működik. A lehető legjobb biztonság érdekében frissítsen a legújabb verzióra, amint elérhető."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streymisþjónarnir hafa endurnýjað SSL vottorð sín. Forritið keyrir í samhæfnisstillingu. Vinsamlegast uppfærðu í nýjustu útgáfu þegar hún er tiltæk fyrir besta öryggi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I server di streaming hanno rinnovato i certificati SSL. L’app funziona in modalità di compatibilità. Aggiorna all’ultima versione non appena disponibile per una sicurezza ottimale."
          }
        },
        "kl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaming-servit SSL nalunaasuutinnik nutaallatippaat. App-ip ataatsimoorsinnaasumik suliarpoq. Immikkoortoq piqqusivippat nutaallatitse immikkoortoormut."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Srautų perdavimo serveriai atnaujino savo SSL sertifikatus. Programa veikia suderinamumo režimu. Prašome atnaujinti į naujausią versiją, kai ji bus prieinama, kad užtikrintumėte optimalų saugumą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Straumēšanas serveri ir atjaunojuši savus SSL sertifikātus. Lietotne darbojas saderības režīmā. Lūdzu, atjauniniet uz jaunāko versiju, kad tā būs pieejama, lai nodrošinātu optimālu drošību."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaming-serverne har fornyet sine SSL-sertifikater. Appen kjører i kompatibilitetsmodus. Vennligst oppdater til nyeste versjon når den er tilgjengelig for optimal sikkerhet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De streaming servers hebben hun SSL-certificaten vernieuwd. De app werkt in compatibiliteitsmodus. Werk bij naar de nieuwste versie wanneer beschikbaar voor optimale beveiliging."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaming-tenarane har fornyet SSL-sertifikata sine. Appen køyrer i kompatibilitetsmodus. Ver snill og oppdater til nyaste versjon når ho er tilgjengeleg for optimal tryggleik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwery streamingowe odnowiły swoje certyfikaty SSL. Aplikacja działa w trybie kompatybilności. Prosimy o aktualizację do najnowszej wersji, gdy będzie dostępna, dla optymalnego bezpieczeństwa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os servidores de transmissão renovaram os certificados SSL. A app está a funcionar em modo de compatibilidade. Atualize para a versão mais recente quando estiver disponível para uma segurança ótima."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverele de streaming și-au reînnoit certificatele SSL. Aplicația funcționează în modul de compatibilitate. Actualizează la cea mai recentă versiune când este disponibilă pentru o securitate optimă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потоковые серверы обновили свои SSL-сертификаты. Приложение работает в режиме совместимости. Пожалуйста, обновитесь до последней версии, когда она будет доступна, для оптимальной безопасности."
          }
        },
        "se" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaming-serverat leat ođasmahttán iežaset SSL-duođaštusat. App doaibmá ovttaoaivvildanvuogis. Ođasmahte ođasmosá verošuvdnii go lea oažžumis, buoremus sihkkarvuođa dihtii."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streamovacie servery obnovili svoje SSL certifikáty. Aplikácia pracuje v kompatibilnom režime. Aktualizujte na najnovšiu verziu, keď bude dostupná, pre optimálnu bezpečnosť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pretočni strežniki so obnovili svoja potrdila SSL. Aplikacija deluje v združljivostnem načinu. Za optimalno varnost posodobite na najnovejšo različico, ko bo na voljo."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serverët e transmetimit kanë rinovuar certifikatat SSL. Aplikacioni po punon në modalitetin e përputhshmërisë. Përditësojeni me versionin më të fundit sapo të jetë i disponueshëm për siguri optimale."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streamingservrarna har förnyat sina SSL-certifikat. Appen körs i kompatibilitetsläge. Vänligen uppdatera till senaste versionen när tillgänglig för optimal säkerhet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потокові сервери оновили свої SSL-сертифікати. Програма працює в режимі сумісності. Будь ласка, оновіть до останньої версії, коли вона буде доступна, для оптимальної безпеки."
          }
        }
      }
    },
