    "clear_local_state_message" : {
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ይህ መጫወትን ያቆማል፣ የዊጄት እና የ Live Activity ውሂብን ያስወግዳል፣ እንዲሁም ከዚህ መሣሪያ የቅርብ ጊዜ ማዳመጥ ሁኔታን ያጸዳል። ይህን እርምጃ መቀልበስ አይቻልም።"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това ще спре възпроизвеждането, ще премахне данните за джаджата и Live Activity и ще изчисти скорошното състояние на слушане от това устройство. Действието не може да бъде отменено."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímto se zastaví přehrávání, odstraní se data widgetu a Live Activity a z tohoto zařízení se vymaže nedávný stav poslechu. Tuto akci nelze vrátit zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil stoppe afspilning, fjerne widget- og Live Activity-data og rydde nylig lytteaktivitet fra denne enhed. Handlingen kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird die Wiedergabe gestoppt, Widget- und Live-Activity-Daten entfernt und der letzte Hörstatus von diesem Gerät gelöscht. Die Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό θα σταματήσει την αναπαραγωγή, θα αφαιρέσει τα δεδομένα γραφικού στοιχείου και Ζωντανής δραστηριότητας και θα διαγράψει την πρόσφατη κατάσταση ακρόασης από αυτήν τη συσκευή. Η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will stop playback, remove widget and Live Activity data, and clear recent listening state from this device. The action cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto detendrá la reproducción, eliminará los datos del widget y de Live Activity, y borrará el estado reciente de escucha de este dispositivo. La acción no se puede deshacer."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See peatab esituse, eemaldab vidina ja Live Activity andmed ning kustutab hiljutise kuulamise oleku sellest seadmest. Toimingut ei saa tagasi võtta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä pysäyttää toiston, poistaa widget- ja Live Activity -tiedot sekä tyhjentää viimeisimmän kuuntelutilan tältä laitteelta. Toimintoa ei voi peruuttaa."
          }
        },
        "fit" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä pysäyttää toiston, poistaa widget- ja Live Activity -tiedot sekä tyhjentää viimeisimmän kuuntelutilan tältä laitteelta. Toimintoa ei voi peruuttaa."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hetta steðgar avspæling, fjarheldur widget og Live Activity dáta, og reinsar nýggjasta lýðingastøðu frá hesum tóleindini. Gerðin kann ikki angrast."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela arrêtera la lecture, supprimera les données du widget et de l’Activité en direct, et effacera l’état d’écoute récent de cet appareil. Cette action est irréversible."
          }
        },
        "gag" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, çalmaayı durduracek, vidjet hem Live Activity verilerini kaldıracek hem bu aletdän son dinlemää durumunu silecek. Bu işlem geriyä alınamaz."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo će zaustaviti reprodukciju, ukloniti podatke widgeta i Aktivnosti uživo te obrisati nedavno stanje slušanja s ovog uređaja. Radnju nije moguće poništiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez leállítja a lejátszást, eltávolítja a widget és az élő tevékenység adatait, és törli a közelmúltbeli hallgatási állapotot erről az eszközről. A művelet nem vonható vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan menghentikan pemutaran, menghapus data widget dan Live Activity, serta menghapus status mendengarkan terbaru dari perangkat ini. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þetta mun stöðva afspilun, fjarlægja græju- og Live Activity gögn og hreinsa nýlega hlustunarstöðu af þessu tæki. Aðgerðin er ekki afturkræf."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo interromperà la riproduzione, rimuoverà i dati del widget e dell’Attività in tempo reale e cancellerà lo stato di ascolto recente da questo dispositivo. L’azione non può essere annullata."
          }
        },
        "kl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una playback nungortippaa, widget aamma Live Activity data peerpai, uani device-mi kingullermik tusarnaarneq nungortippaa. Suliaq anguniagassanngilaq."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tai sustabdys atkūrimą, pašalins valdiklio ir Live Activity duomenis bei išvalys naujausią klausymo būseną iš šio įrenginio. Veiksmo negalima atšaukti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tas apturēs atskaņošanu, noņems logrīka un Live Activity datus un notīrīs neseno klausīšanās stāvokli no šīs ierīces. Darbību nevar atsaukt."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil stoppe avspilling, fjerne widget- og Live Activity-data og tømme nylig lytteaktivitet fra denne enheten. Handlingen kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee wordt het afspelen gestopt, widget- en Live Activity-gegevens verwijderd en de recente luisterstatus van dit apparaat gewist. De actie kan niet ongedaan worden gemaakt."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil stoppe avspeling, fjerne widget- og Live Activity-data og tømme nyleg lyttestatus frå denne eininga. Handlinga kan ikkje angrast."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to zatrzymanie odtwarzania, usunięcie danych widżetu i Live Activity oraz wyczyszczenie ostatniego stanu słuchania z tego urządzenia. Tej czynności nie można cofnąć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto irá parar a reprodução, remover os dados do widget e da Live Activity e apagar o estado de audição recente deste dispositivo. A ação não pode ser anulada."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso vai parar a reprodução, remover os dados do widget e da Live Activity e apagar o estado recente de escuta deste dispositivo. Esta ação não pode ser desfeita."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceasta va opri redarea, va elimina datele widgetului și ale Activității live și va șterge starea recentă de ascultare de pe acest dispozitiv. Acțiunea nu poate fi anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это остановит воспроизведение, удалит данные виджета и Live Activity и очистит недавнее состояние прослушивания с этого устройства. Действие нельзя отменить."
          }
        },
        "se" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dát čuožžastit čuojastusa, sihko widget ja Live Activity dáhta ja sihko dáid áigge čuojastusa dáhta dáin čuoččastahkan. Dahku ii sáhte čorget."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Týmto sa zastaví prehrávanie, odstránia sa údaje widgetu a Live Activity a vymaže sa nedávny stav počúvania z tohto zariadenia. Túto akciu nie je možné vrátiť späť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To bo ustavilo predvajanje, odstranilo podatke pripomočka in Live Activity ter počistilo nedavno stanje poslušanja s te naprave. Dejanja ni mogoče razveljaviti."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjo do të ndalojë luajtjen, do të heqë të dhënat e widget-it dhe Live Activity, dhe do të pastrojë gjendjen e fundit të dëgjimit nga kjo pajisje. Veprimi nuk mund të zhbëhet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta stoppar uppspelningen, tar bort widget- och Live Activity-data och rensar den senaste lyssningsstatusen från den här enheten. Åtgärden kan inte ångras."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hii itasimamisha uchezaji, kuondoa data ya wijeti na Live Activity, na kufuta hali ya hivi karibuni ya kusikiliza kutoka kwenye kifaa hiki. Kitendo hiki hakiwezi kubatilishwa."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇది ప్లేబ్యాక్‌ని ఆపి, విడ్జెట్ మరియు Live Activity డేటాను తొలగించి, ఈ పరికరం నుండి ఇటీవలి వినికిడి స్థితిని క్లియర్ చేస్తుంది. ఈ చర్యను రద్దు చేయలేరు."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це зупинить відтворення, видалить дані віджета та Live Activity і очистить недавній стан прослуховування з цього пристрою. Дію не можна скасувати."
          }
        }
      }
    },
