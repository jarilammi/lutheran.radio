    "tap_to_open" : {
      "comment" : "Home-widget passive chrome primary caption when the main app process is not recently active. Used from WidgetSurface `WidgetPassiveTapToOpenChrome` via String(localized:table: Localizable). extractionState is manual because the catalog is owned by the main app/widget targets; the call site lives in WidgetSurface and is not seen by Xcode auto-extraction.",
      "localizations" : {
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ለመክፈት መታ ያድርጉ"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докоснете, за да отворите"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte pro otevření"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk for at åbne"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Öffnen tippen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε για άνοιγμα"
          }
